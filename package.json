{
  "name": "sollarisbot",
  "version": "1.0.0",
  "description": "A TypeScript Discord bot with music playback for private servers.",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc --project tsconfig.json",
    "dev": "tsx src/index.ts",
    "start": "node dist/index.js",
    "deploy:commands": "tsx src/scripts/deployCommands.ts",
    "migrate:spotify-library": "tsx src/scripts/migrateSpotifyLibraryTracks.ts",
    "typecheck": "tsc --project tsconfig.json --noEmit",
    "test": "tsx --test test/**/*.test.ts",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "keywords": [
    "discord",
    "bot",
    "music",
    "typescript"
  ],
  "author": "",
  "license": "ISC",
  "engines": {
    "node": ">=22.0.0"
  },
  "dependencies": {
    "@discord-player/extractor": "^7.2.0",
    "@discordjs/voice": "^0.19.2",
    "discord-player": "^7.2.0",
    "discord-player-youtubei": "^3.0.0-beta.4",
    "discord.js": "^14.26.2",
    "dotenv": "^17.4.1",
    "ffmpeg-static": "^5.3.0",
    "youtube-dl-exec": "^3.1.4",
    "youtubei.js": "^17.0.1",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@types/node": "^24.7.2",
    "@typescript-eslint/eslint-plugin": "^8.46.1",
    "@typescript-eslint/parser": "^8.46.1",
    "eslint": "^9.37.0",
    "eslint-config-prettier": "^10.1.8",
    "prettier": "^3.6.2",
    "tsx": "^4.20.6",
    "typescript": "^6.0.2"
  }
}
